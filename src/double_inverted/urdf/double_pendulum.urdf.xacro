<?xml version="1.0"?>
<robot name="double_pendulum" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="link_length" value="0.5"/>
  <xacro:property name="link_radius" value="0.02"/>
  <xacro:property name="bob_radius" value="0.05"/>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
  </joint>

  <!-- joint1 = base joint (theta1, 0 = upright). Joint names MUST match
       sim_node's joint_states names. -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 ${link_length/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${link_radius}" length="${link_length}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.9 1"/></material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.283" upper="6.283" effort="10" velocity="20"/>
  </joint>

  <!-- joint2 = elbow joint (theta2, relative to link1). -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 ${link_length/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${link_radius}" length="${link_length}"/></geometry>
      <material name="green"><color rgba="0.1 0.8 0.2 1"/></material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.283" upper="6.283" effort="10" velocity="20"/>
  </joint>

  <link name="bob_link">
    <visual>
      <geometry><sphere radius="${bob_radius}"/></geometry>
      <material name="red"><color rgba="0.9 0.1 0.1 1"/></material>
    </visual>
  </link>

  <joint name="link2_to_bob" type="fixed">
    <parent link="link2"/>
    <child link="bob_link"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
  </joint>

</robot>
